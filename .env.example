# DHRUV environment variables. Copy to .env.local and fill in. Never commit real values.
# Principle: the whole stack is open source and free to run (see PRODUCTION_PLAN.md).

# Supabase (open source; free cloud tier for the demo, self-hostable with Docker for production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI provider behind lib/ai/llm.ts:
#   gemini  - Google AI Studio free tier (demo convenience, not open source)
#   claude  - Anthropic API (paid; optional, not used by default)
#   ollama  - open-weight models on your own machine via Ollama (open source, no keys, no cost)
AI_PROVIDER=gemini

# Ollama (only used when AI_PROVIDER=ollama or EMBEDDING_PROVIDER=ollama). Defaults fit a 4 GB GPU.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL_SMART=qwen3:4b
# OLLAMA_MODEL_FAST=qwen3:4b
# OLLAMA_MODEL_VISION=gemma3:4b
# OLLAMA_EMBED_MODEL=bge-m3
# OLLAMA_NUM_CTX=8192
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=
# Optional Gemini model overrides
# GEMINI_MODEL_SMART=gemini-3.5-flash
# GEMINI_MODEL_FAST=gemini-3.5-flash-lite

# Embeddings for semantic search: ollama (bge-m3, open source) or voyage (free tier). Both are 1024-dim.
# After changing the embedding model, run: npm run reembed
# EMBEDDING_PROVIDER=ollama
VOYAGE_API_KEY=your-voyage-api-key

# Bhashini (MeitY national language platform, free): translation into Indian languages,
# speech-to-text and text-to-speech. Copy both values from your Bhashini dashboard (bhashini.gov.in).
# Put the real values in .env.local only; never commit them or paste them anywhere else.
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# Telegram (free Bot API): approved social posts go live on DHRUV's Telegram channel.
# Create a bot with @BotFather, create a public channel, add the bot as an admin, then set both.
# TELEGRAM_CHANNEL_ID is @your_channel_name (or the numeric -100… id for a private channel).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# AI_MOCK=true: AI steps return fixture output (no external AI calls). Supabase is still required.
AI_MOCK=true

# Public address of this deployment. Generated posts store "{{site}}" and resolve it with this value.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hackathon demo only: show "Uploader" / "Reviewer" quick sign-in buttons on /login.
# Never enable on a deployment that holds real data. Admin accounts are never offered.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_PASSWORD=
# With demo mode on, every account made by scripts/seed.ts (they share the password above, which
# demo mode puts in the page code) is look-only: they can browse the staff workspace but
# every change (upload, generate, approve, publish) is refused, so each judge sees the same archive.
# Set to true only for the team's own live demo, where the demo accounts need to act.
DEMO_ALLOW_WRITES=false

# Dev only: treat every request as super_admin so /admin works without signing in.
# Ignored in production builds.
DEV_AUTH_BYPASS=false

# Only for recording on your own laptop: open the staff pages as this seeded account with no sign-in.
# Ignored when NEXT_PUBLIC_DEMO_MODE=true. Never set it on a public deployment.
LOCAL_DEMO_USER=
